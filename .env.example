# Runtime
NODE_ENV=development
COMPANY_NAME=ALC & Pereira Filho Transportes
APP_BASE_URL=http://localhost:3000
API_PORT=3333
WEB_PORT=3000

# Database and queue
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ticketlog
REDIS_URL=redis://localhost:6379

# Auth
AUTH_MODE=development-header
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
APP_SIGNING_SECRET=replace-with-random-32-byte-secret
FIELD_ENCRYPTION_KEY=replace-with-base64-32-byte-key
APPROVAL_TOKEN_TTL_MINUTES=30
LIMIT_DOUBLE_APPROVAL_FROM=0
LIMIT_WINDOW_HOURS=24

# Valores em BRL. GERAL_DE_RESTRICOES e usado como fallback quando o grupo nao foi identificado.
LIMIT_GROUP_GERAL_DE_RESTRICOES=2000
LIMIT_GROUP_VEICULO_DE_PASSEIO=70
LIMIT_GROUP_UTILITARIOS=90
LIMIT_GROUP_VAN=100
LIMIT_GROUP_VUC=150

# WhatsApp
WHATSAPP_PROVIDER=meta-cloud
WHATSAPP_VERIFY_TOKEN=replace-with-webhook-verify-token
WHATSAPP_APP_SECRET=replace-with-meta-app-secret
WHATSAPP_API_BASE_URL=https://graph.facebook.com/vXX.X
WHATSAPP_ACCESS_TOKEN=replace-with-provider-token
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_SESSION_EXPIRY_MINUTES=15
WHATSAPP_MAX_AUTH_ATTEMPTS=5
WHATSAPP_TEMP_BLOCK_MINUTES=30

# Ticket Log / Sou Log+
TICKETLOG_PROVIDER_MODE=simulation
TICKETLOG_LOGIN_URL=
TICKETLOG_HOME_URL=https://plataforma.ticketlog.com.br/home
TICKETLOG_VEHICLE_LIST_URL=https://plataforma.ticketlog.com.br/register/fleet/vehicle/list
TICKETLOG_USERNAME=
TICKETLOG_PASSWORD=
TICKETLOG_SESSION_STORAGE_PATH=storage-state/ticketlog.json
TICKETLOG_USER_DATA_DIR=storage-state/ticketlog-profile
TICKETLOG_HEADLESS=true
TICKETLOG_REAL_EXECUTION=false
TICKETLOG_REAL_ALLOWED_PLATES=
TICKETLOG_REAL_ALLOWED_AMOUNT=
TICKETLOG_ALLOW_MANUAL_LOGIN=false
TICKETLOG_MANUAL_LOGIN_CONTINUE=auto
TICKETLOG_MANUAL_LOGIN_TIMEOUT_MS=900000
TICKETLOG_STATION_MODE=false
TICKETLOG_OPERATOR_URL=
TICKETLOG_OPERATOR_ACCESS_TOKEN=
TICKETLOG_OPERATOR_PASSWORD=
WORKER_CONCURRENCY=1
LIMIT_JOB_ATTEMPTS=3
LIMIT_RETRY_DELAY_MS=15000

# Evidence storage
EVIDENCE_PROVIDER=local-dev
EVIDENCE_BUCKET=
EVIDENCE_ACCESS_KEY=
EVIDENCE_SECRET_KEY=
EVIDENCE_REGION=

# Observability
SENTRY_DSN=
LOG_LEVEL=info
